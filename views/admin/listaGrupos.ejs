<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de Grupos - ECOVIF</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style-raiz.css">
  <link rel="stylesheet" href="/css/style-login.css">
  <link rel="stylesheet" href="/css/style-area-gestor.css">
  <link rel="stylesheet" href="/css/style-funcionario.css">
</head>

<body>
  <!-- Navbar igual ao seu -->
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="/area-gestor"><i class="fa-solid fa-utensils"></i> ECOVIF
        <span class="tagline">Sistema de Gestão para Restaurantes</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/area-gestor">
              <i class="fa-solid fa-user-shield"></i> Área do Gestor
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/cadastrarFuncionario">
              <i class="fa-solid fa-user-plus"></i> Funcionários
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/suporte">
              <i class="fa-solid fa-headset"></i> Suporte
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/cadastrarGrupo">Voltar</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login" id="logoutBtn">
              <i class="fa-solid fa-sign-out-alt"></i> Sair
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Header -->
  <section class="cabecalho-gestor">
    <div class="container">
      <div class="welcome-box">
        <div class="user-info">
          <div class="user-avatar">
            <i class="fa-solid fa-users"></i>
          </div>
          <div>
            <h1>Lista de Grupos</h1>
            <p>Gerencie os grupos do restaurante</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Principal -->
  <main class="funcionalidades-grid">
    <div class="container">
      <!-- Tabela de Grupos -->
      <div class="caixa-categoria">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3><i class="fa-solid fa-list"></i> Grupos Cadastrados</h3>
        </div>
        <div class="d-flex justify-content-between align-items-right mb-3">
          <a href="/cadastrarGrupo" class="btn btn-success btn-sm">
            <i class="fa-solid fa-plus"></i> Novo Grupo
          </a>
        </div>
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nome do Grupo</th>
              <th>Descrição</th>
              <th width="200">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (grupos && grupos.length > 0) { %>
            <% grupos.forEach(grupo => { %>
            <tr id="linha-<%= grupo.id %>">
              <td><%= grupo.id %></td>
              <td class="col-nome"><%= grupo.nome_grupo %></td>
              <td class="col-descricao"><%= grupo.descricao_grupo %></td>
              <td>
                <!-- Botão Editar (Alterna para modo edição) -->
                <button type="button" class="btn btn-warning btn-sm btn-editar" onclick="ativarEdicao('<%= grupo.id %>')">
                  <i class="fa-solid fa-pen"></i> Editar
                </button>

                <!-- Botão Salvar (Invisível por padrão) -->
                <button type="button" class="btn btn-success btn-sm btn-salvar d-none" onclick="salvarEdicao('<%= grupo.id %>')">
                  <i class="fa-solid fa-check"></i> Salvar
                </button>

                <form action="/admin/grupos/excluir/<%= grupo.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Este grupo só pode ser excluido se não estiver sendo utilizado por outros funcionários.')">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
        <div class="text-end mt-3">
          <a href="/cadastrarGrupo" class="btn btn-login-voltar">
            <i class="fa-solid fa-arrow-left"></i> Voltar
          </a>
        </div>
      </div>
    </div>
  </main>

  <!-- Rodapé -->
  <footer class="rodape">
    <div class="container">
      <p>2026 Desenvolvido por Ritielen Rodrigues</p>
    </div>
  </footer>
  <script src="/js/listaGrupoScript.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>