<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - ECOVIF</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/css/style-raiz.css" />
    <link rel="stylesheet" href="/css/style-login.css" />
    <link rel="stylesheet" href="/css/style-area-gestor.css" />
    <link rel="stylesheet" href="/css/style-dashboard.css" />
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
      <div class="container">
        <a class="navbar-brand" href="#ecovif"
          ><i class="fa-solid fa-utensils"></i> ECOVIF
          <span class="tagline">Sistema de Gestão para Restaurantes</span>
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div
          class="collapse navbar-collapse justify-content-end"
          id="navbarNav"
        >
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/area-gestor">
                <i class="fa-solid fa-user-shield"></i> Área do Gestor
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/login/suporte">Suporte</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/login" id="logoutBtn"
                ><i class="fa-solid fa-sign-out-alt"></i> Sair</a
              >
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Header -->
    <section class="cabecalho-gestor">
      <div class="container">
        <div class="welcome-box">
          <div class="user-info">
            <div class="user-avatar">
              <i class="fa-solid fa-chart-line"></i>
            </div>
            <div>
              <h1>Dashboard</h1>
              <p>Relatórios e análises do restaurante</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Dashboard Principal -->
    <main class="funcionalidades-grid">
      <div class="container">
        <!-- Cards de Resumo -->
        <div class="row g-4 mb-4">
          <div class="col-md-3">
            <div class="card-resumo card-faturamento">
              <div class="card-icone">
                <i class="fa-solid fa-dollar-sign"></i>
              </div>
              <div class="card-info">
                <h3>Faturamento Bruto</h3>
                <p class="valor" id="faturamentoTotal">R$ </p>
                <small></small>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-resumo card-despesas">
              <div class="card-icone">
                <i class="fa-solid fa-shopping-cart"></i>
              </div>
              <div class="card-info">
                <h3>Despesas</h3>
                <p class="valor" id="despesasTotal">R$ </p>
                <small>Compras do mês</small>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-resumo card-lucro">
              <div class="card-icone">
                <i class="fa-solid fa-chart-line"></i>
              </div>
              <div class="card-info">
                <h3>Lucro Líquido</h3>
                <p class="valor" id="lucroTotal">R$ </p>
                <small></small>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-resumo card-ticket">
              <div class="card-icone">
                <i class="fa-solid fa-receipt"></i>
              </div>
              <div class="card-info">
                <h3>Ticket Médio</h3>
                <p class="valor" id="ticketMedio">R$ </p>
                <small></small>
              </div>
            </div>
          </div>
        </div>

        <!-- Alertas de Estoque -->
        <div class="caixa-categoria mb-4">
          <h3>
            <i class="fa-solid fa-exclamation-triangle"></i> Alertas de Estoque
            Mínimo
          </h3>
          <div id="alertasEstoque" class="alertas-container"></div>

          <div class="alerta-info">
            <h4><i class="fa-solid fa-exclamation-triangle"></i> nome</h4>
            <p>
              Estoque atual: quantidadeTotal g | Mínimo: quantidadeMinima kg
            </p>
          </div>
          <div class="alerta-quantidade">qtg total</div>
          <p class="texto-vazio" id="semAlertas">
            Nenhum item com estoque baixo.
          </p>
        </div>
        <!-- Itens Mais Vendidos -->
        <div class="caixa-categoria mb-4">
          <h3><i class="fa-solid fa-trophy"></i> Ranking de Produtos</h3>

          <form class="seletor-mes row gy-3 gx-2 align-items-end" method="get" action="/relatorio">
            <input type="hidden" name="relatorioMes" >
            <input type="hidden" name="relatorioAno"  >
            <div class="col-auto">
              <label>Selecione o Mês:</label>
              <select class="controle-formulario" name="rankingMes">
                <% meses.forEach(function(mes) { %>
                  <option value="<%= mes.valor %>" <%= mes.valor === selectedRankingMes.toString().padStart(2, '0') ? 'selected' : '' %>><%= mes.label %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-auto">
              <label>Selecione o Ano:</label>
              <select class="controle-formulario" name="rankingAno">
                <% anos.forEach(function(ano) { %>
                  <option value="<%= ano %>" <%= ano === selectedRankingAno ? 'selected' : '' %>><%= ano %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-auto">
              <button type="submit" class="btn btn-primary">Aplicar Ranking</button>
            </div>
          </form>

          <!-- Tabela de Itens Vendidos -->
          <div class="tabela-vendidos">
            <table class="tabela-dashboard">
              <thead>
                <tr>
                  <th>Posição</th>
                  <th>Produto</th>
                  <th>Tipo</th>
                  <th>Quantidade Vendida</th>
                  <th>Faturamento</th>
                </tr>
              </thead>
              <tbody id="tabelaVendidos">
                <% if (rankingProdutos && rankingProdutos.length > 0) { %>
                  <% rankingProdutos.forEach(function(item) { %>
                    <tr>
                      <td><%= item.posicao %></td>
                      <td><%= item.nome %></td>
                      <td><%= item.tipo === 'prato' ? 'Prato' : 'Bebida' %></td>
                      <td><%= item.quantidade_vendida %></td>
                      <td>R$ <%= item.faturamento_produto.toFixed(2).replace('.', ',') %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="texto-vazio">
                      Nenhum ranking disponível para este mês.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Relatório Mensal -->
        <div class="caixa-categoria mb-4">
          <h3>
            <i class="fa-solid fa-calendar-alt"></i> Relatório Mensal
          </h3>

          <form class="seletor-mes row gy-3 gx-2 align-items-end" method="get" action="/relatorio">
            <input type="hidden" name="rankingMes"  >
            <input type="hidden" name="rankingAno" >
            <div class="col-auto">
              <label>Selecione o Mês:</label>
              <select class="controle-formulario" name="relatorioMes">
                <% meses.forEach(function(mes) { %>
                  <option value="<%= mes.valor %>" <%= mes.valor === selectedRelatorioMes.toString().padStart(2, '0') ? 'selected' : '' %>><%= mes.label %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-auto">
              <label>Selecione o Ano:</label>
              <select class="controle-formulario" name="relatorioAno">
                <% anos.forEach(function(ano) { %>
                  <option value="<%= ano %>" <%= ano === selectedRelatorioAno ? 'selected' : '' %>><%= ano %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-auto">
              <button type="submit" class="btn btn-primary">Aplicar Relatório</button>
            </div>
          </form>

          <div class="tabela-comparativo mt-4">
            <table class="tabela-dashboard">
              <thead>
                <tr>
                  <th>Mês</th>
                  <th>Ano</th>
                  <th>Faturamento Bruto</th>
                  <th>Despesas</th>
                  <th>Lucro Líquido</th>
                  <th>% Margem</th>
                  <th>Ticket Médio</th>
                </tr>
              </thead>
              <tbody id="tabelaComparativo">
                <% if (relatorioExiste) { %>
                  <tr>
                    <td></td>
                    <td></td>
                    <td>R$ </td>
                    <td>R$ </td>
                    <td>R$ </td>
                    <td></td>
                    <td>R$ </td>
                  </tr>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="texto-vazio">
                      Nenhum relatório mensal registrado para este mês.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Botão Voltar -->
        <div class="text-end mt-3">
          <a href="/area-gestor" class="btn btn-login-voltar"
            ><i class="fa-solid fa-arrow-left"></i> Voltar</a
          >
        </div>

        <!-- Botões de Exportação -->
        <div class="acoes-exportacao">
          <button class="btn-login">
            <i class="fa-solid fa-file-pdf"></i> Exportar Relatório PDF
          </button>
          <button class="btn-login">
            <i class="fa-solid fa-file-excel"></i> Exportar Relatório Excel
          </button>
        </div>
      </div>
    </main>

    <!-- Rodapé -->
    <footer class="rodape">
      <div class="container">
        <p>2026 Desenvolvido por Ritielen Rodrigues.</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
