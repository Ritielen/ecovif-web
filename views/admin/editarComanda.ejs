<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edição da Comanda - ECOVIF</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style-raiz.css">
  <link rel="stylesheet" href="/css/style-login.css">
  <link rel="stylesheet" href="/css/style-area-gestor.css">
  <link rel="stylesheet" href="/css/style-cardapio.css">
  <link rel="stylesheet" href="/css/style-comandas.css">
  <link rel="stylesheet" href="/css/style-pedidos-cozinha.css">

</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="/area-gestor"><i class="fa-solid fa-utensils"></i> ECOVIF
        <span class="tagline">Sistema de Gestão para Restaurantes</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/area-gestor">
              <i class="fa-solid fa-user-shield"></i> Área do Gestor
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/comanda">Voltar</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/suporte">Suporte</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login" id="logoutBtn">
              <i class="fa-solid fa-sign-out-alt"></i>
              Sair</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <!-- Header da Área do Gestor -->
  <section class="cabecalho-gestor">
    <div class="container">
      <div class="welcome-box">
        <div class="user-info">
          <div class="user-avatar">
            <i class="fa-solid fa-receipt"></i>
          </div>
          <div>
            <h1>Editar Comanda</h1>
            <p>Gerencie comandas, pedidos e controle total das mesas.</p>
          </div>
        </div>

      </div>
    </div>
  </section>
  <!-- Principal -->
  <main class="funcionalidades-grid">
    <div class="container">
      <div class="row">
        <!-- Seção Formulário -->
        <%- include('../partials/alerts') %>

        <section class="col-lg-5 secao-formulario">
          <div class="caixa-formulario">
            <h2>Editar Comanda</h2>

            <form action="/editarComanda/<%= comanda.id %>" method="post" id="formComanda">

              <div class="grupo-formulario">
                <label class="label-formulario">Nome do Cliente</label>
                <input type="text" name="nome_cliente" class="controle-formulario" id="nomeCliente" value="<%= comanda.nome_cliente %>">
              </div>

              <div class="grupo-formulario">
                <label class="label-formulario">Número da Mesa</label>
                <input type="number" name="mesa" class="controle-formulario" id="numeroMesa" value="<%= comanda.mesa %>">
              </div>

              <!-- Seção Itens da Comanda -->
              <div class="secao-itens-comanda">
                <h3>Itens da Comanda</h3>
                <!-- Seletor de Cardápio -->
                <div class="grupo-formulario">
                  <label class="label-formulario">Selecionar do Cardápio</label>
                  <select class="controle-formulario" id="selectCardapio">
                    <option value="">Escolha um item...</option>

                    <!-- Grupo de Pratos -->
                    <% if (pratos && pratos.length > 0) { %>
                    <optgroup label="Pratos">
                      <% pratos.forEach(prato => { %>
                      <option value="prato_<%= prato.id %>" data-preco="<%= prato.preco_venda %>" data-tipo="prato">
                        <%= prato.nome %> - R$ <%= Number(prato.preco_venda).toFixed(2) %>
                      </option>
                      <% }) %>
                    </optgroup>
                    <% } %>

                    <!-- Grupo de Bebidas -->
                    <% if (bebidas && bebidas.length > 0) { %>
                    <optgroup label="Bebidas">
                      <% bebidas.forEach(bebida => { %>
                      <option value="bebida_<%= bebida.id %>" data-preco="<%= bebida.preco_venda %>" data-tipo="bebida">
                        <%= bebida.produto.nome %> - <%= bebida.produto.tamanho %> - <%= bebida.produto.unidade %> - R$ <%= Number(bebida.preco_venda).toFixed(2) %>
                      </option>
                      <% }) %>
                    </optgroup>
                    <% } %>
                  </select>
                </div>

                <div class="linha-formulario">
                  <div class="grupo-formulario">
                    <label class="label-formulario">Quantidade</label>
                    <input type="number" name="quantidade" class="controle-formulario" id="quantidadeItem" min="1" value="1">
                  </div>
                  <div class="grupo-formulario" style="display: flex; align-items: flex-end;">
                    <button type="button" class="btn-adicionar-item">
                      <i class="fa-solid fa-plus"></i> Adicionar
                    </button>
                  </div>
                </div>
                <!--lista dos itens já cadastrados-->

                <div class="comanda-itens">

                  <% if (comanda.itens && comanda.itens.length > 0) { %>

                  <% comanda.itens.forEach(item => { %>

                  <div class="item-info" data-id="<%= item.id %>">

                    <span class="item-nome">

                      <% if (item.tipo_item === "prato") { %>

                      <%= item.prato.nome %> -
                      Qtd: <%= item.quantidade %>
                      R$: <%= Number(item.prato.preco_venda).toFixed(2) %>

                      <% } %>

                      <% if (item.tipo_item === "bebida") { %>

                      <%= item.bebida.produto.nome %> -
                      <%= item.bebida.produto.tamanho %> -
                      <%= item.bebida.produto.unidade %> -
                      Qtd: <%= item.quantidade %> -
                      R$: <%= Number(item.bebida.preco_venda).toFixed(2) %>

                      <% } %>

                    </span>

                    <button type="button" class="btn-remover-item" onclick="removerItemDoBanco(<%= item.id %>, this)">
                      <i class="fa-solid fa-minus"></i>
                    </button>
                    <div>
                      Total Atual: R$ <%= comanda.total %>
                    </div>
                  </div>

                  <% }) %>

                  <% } %>

                </div>
                <!--caixa com a lista dos itens adicionados-->
                <div class="item-acoes">
                  <div class="lista-itens-adicionados" id="listaItensAdicionados">
                    <p class="texto-vazio" id="vazioItens">Nenhum item adicionado</p>
                  </div>
                </div>

                <!-- Total da Comanda -->
                <div class="total-comanda">
                  <strong>Total:</strong>
                  <span id="totalComanda"> R$ </span>
                </div>
              </div>
              <!-- OBSERVAÇÕES DA COMANDA -->
              <div class="grupo-formulario">
                <label class="label-formulario">Observações do Pedido</label>
                <textarea class="controle-formulario" name="observacoes" id="observacoesComanda" rows="3"></textarea>
                <small class="texto-ajuda">Observação atual: <%= comanda.observacoes || 'Não informada' %> </small>
              </div>
              <button type="submit" class="btn-login">
                <i class="fa-solid fa-check-circle"></i> <span id="textoBotao">Atualizar Comanda</span>
              </button>
            </form>
          </div>
        </section>

        <!-- Botão Voltar -->
        <div class="text-end mt-3">
          <a href="/comanda" class="btn btn-login-voltar">
            <i class="fa-solid fa-arrow-left"></i> Voltar
          </a>
        </div>
        </section>
      </div>
  </main>
  <!-- Rodapé -->
  <footer class="rodape">
    <div class="container">
      <p>2026 Desenvolvido por Ritielen Rodrigues.</p>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script src="/js/edicaoComandaScript.js"></script>
  
  <script src="/js/formularioEstoqueScript.js"></script>

  <script>

  </script>
</body>

</html>