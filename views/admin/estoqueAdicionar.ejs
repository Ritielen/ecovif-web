<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estoque Edição- ECOVIF</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style-raiz.css">
    <link rel="stylesheet" href="/css/style-login.css">
    <link rel="stylesheet" href="/css/style-area-gestor.css">
  
    <link rel="stylesheet" href="/css/style-estoque-editar.css">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/area-gestor">
                <i class="fa-solid fa-utensils"></i> ECOVIF
                <span class="tagline">Sistema de Gestão para Restaurantes</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/area-gestor">
                            <i class="fa-solid fa-user-shield"></i> Área do Gestor
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/login/suporte">Suporte</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/login" id="logoutBtn">
                            <i class="fa-solid fa-sign-out-alt"></i>
                            Sair
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- Header da Área do Gestor -->
    <section class="cabecalho-gestor">
        <div class="container">
            <div class="welcome-box">
                <div class="user-info">
                    <div class="user-avatar">
                        <i class="fa-solid fa-boxes"></i>
                    </div>
                    <div>
                        <h1>Edição dos Produtos</h1>
                        <p>Gerencie o estoque de produtos e bebidas do restaurante</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <%- include ('../partials/alerts') %>
    
                <!-- Seção Formulário -->
                 <section class="secao-formulario">
            <!-- ========================= -->
            <!-- GRID  (DADOS) -->
            <!-- ========================= -->
             <div class="caixa-formulario tabela-full">
  <h2>Histórico de Movimentações</h2>
  <div class="table-responsive">
    <table class="table table-striped">
      <tbody>
  <!-- CABEÇALHO DO PRODUTO  -->
  <tr style="background-color: #f8f9fa; font-weight: bold;">
    <td>Tipo</td>
    <td>Nome</td>
    <td>Data Validade Original</td>
    <td>Quantidade Inicial</td>
    <td>Estoque Atual (Saldo)</td> 
    <td>Categoria</td>
    <td>Qtd Mínima</td>
    <td>Valor compra</td>
    <td>Ações</td>
  </tr>

  <!-- DADOS DO PRODUTO (Resumo Geral) -->
  <tr>
    <td><%= produto.tipo_item %></td>
    <td><%= produto.nome %></td>
    <td><%= produto.data_validade || 'Não informada' %></td>
    
    <!-- QUANTIDADE INICIAL: Valor que não muda -->
    <td style="color: #666;"><%= produto.quantidade_inicial %> <%= produto.unidade %></td>

    <!-- ESTOQUE ATUAL: Saldo real somado no banco -->
    <td style="font-weight: bold; color: #007bff;">
      <%= produto.quantidade %>
      <% if (produto.tipo_item === 'bebida') { %>
        (<%= produto.tamanho %> <%= produto.unidade %>)
      <% } else { %>
        <%= produto.unidade %>
      <% } %>
    </td>
    <td><%= produto.categoria || 'Não definida' %></td>
    <td><%= produto.quantidade_minima %> <%= produto.unidade %></td>
    
    <!-- VALOR TOTAL: Soma de todas as compras desse produto -->
    <td style="font-weight: bold;">R$ <%= Number(produto.valor_compra).toFixed(2) %></td>
    
    <td>
      <form action="/admin/produto/excluir/<%= produto.id %>" method="POST" onsubmit="return confirm('Excluir este produto apagará todo o histórico. Deseja continuar?')">
        <button type="submit" class="btn-excluir">Excluir</button>
      </form>
    </td>
  </tr>

  <!-- ESPAÇADOR -->
  <tr style="height: 20px;"><td colspan="9"></td></tr>

  <!-- CABEÇALHO DAS MOVIMENTAÇÕES (Histórico de Lotes) -->
  <tr style="background-color: #e9ecef;">
    <th>Tipo</th>
    <th>Qtd. Adicionada</th>
    <th>Validade do Lote</th>
    <th>Saldo na Época</th>
    <th>Valor da Entrada</th>
    <th>Custo Total Até Então</th>
    <th colspan="2">Data do Registro</th>
    <th></th>
  </tr>

  <!-- LISTA DE MOVIMENTAÇÕES -->
  <% movimentacoes.forEach(mov => { %>
    <tr>
      <td><span class="badge-tipo"><%= mov.tipo %></span></td>
      <td>+ <%= mov.nova_quantidade %></td>
      <td><%= mov.nova_data_validade || 'Mesma do cadastro' %></td>
      <td><%= mov.quantidade_total %></td>
      <td>R$ <%= Number(mov.novo_valor_compra).toFixed(2) %></td>
      <td>R$ <%= Number(mov.valor_total_gasto).toFixed(2) %></td>
      <td colspan="2" style="font-size: 0.85em; color: #888;">
        <%= new Date(mov.created_at).toLocaleDateString('pt-BR') %>
      </td>
      <td></td>
    </tr>
  <% }) %>
</tbody>
        
    </table>
  </div>
</div>

            <!-- ========================= -->
            <!-- GRID (EDIÇÃO) -->
            <!-- ========================= -->
             
            <div class="form-grid" >
                <div class="form-col">
              
            <!--<section class="col-lg-6 mb-4 "> -->
                <div class="caixa-formulario">
                    <h2>Editar item</h2>

                    <form action="/admin/produto/editar/<%= produto.id %>" method="POST">

                        <!-- PRODUTO -->
                        <% if (produto.tipo_item === 'produto') { %>
                             <div class="linha-formulario">
                                <div class="grupo-formulario">
                                    <label class="label-formulario">Editar Nome</label>
                                    <input type="string" class="controle-formulario" name="nome" value="<%= produto.nome %>">
                                </div>
                                
                            <div class="grupo-formulario">
                                <label class="label-formulario">Nova Data</label>
                                <input type="date" class="controle-formulario" name="nova_data_validade" >
                                <small>Data atual: <%= produto.data_validade || 'Não informada' %> </small>
                            </div>
                        </div>
                            <div class="grupo-formulario">
                                <label class="label-formulario">Nova Categoria</label>
                                <select class="controle-formulario" name="categoria" value="<%= produto.categoria  %>">
                                    <option value="alto_custo">Alto Custo</option>
                                    <option value="medio_custo">Médio Custo</option>
                                    <option value="baixo_custo">Baixo Custo</option>
                                </select>
                            </div>
                            <div class="linha-formulario">
                                <div class="grupo-formulario">
                                    <label class="label-formulario">Adicionar Quantidade</label>
                                    <input type="number" class="controle-formulario" name="nova_quantidade" >
                                </div>
                                <div class="grupo-formulario">
                                    <label class="label-formulario">Editar Quantidade Mínima</label>
                                    <input type="number" class="controle-formulario" name="quantidade_minima" >
                                    <small>Quantidade mínima atual: <%= produto.quantidade_minima %> </small>
                                </div>
                            </div>
                        <% } %>
                        <!-- BEBIDA -->
                        <% if (produto.tipo_item === 'bebida') { %>
                            <div class="linha-formulario">
                                <div class="grupo-formulario">
                                    <label class="label-formulario">Editar Nome</label>
                                    <input type="string" class="controle-formulario" name="nome" value="<%= produto.nome %>">
                                </div>
                            <div class="grupo-formulario">
                                <label class="label-formulario">Nova Data</label>
                                <input type="date" class="controle-formulario" name="nova_data_validade">
                                <small>Data atual: <%= produto.data_validade || 'Não informada' %></small>
                            </div>
                            </div>
                            <div class="linha-formulario">
                                <div class="grupo-formulario">
                                    <label class="label-formulario">Adicionar Quantidade</label>
                                    <input type="number" class="controle-formulario" name="nova_quantidade" >
                                    <small>Estoque atual: <%= produto.quantidade %> <%= produto.unidade %></small>
                                </div>
                                <div class="grupo-formulario">
                                    <label class="label-formulario">Editar Quantidade Mínima</label>
                                    <input type="number" class="controle-formulario" name="quantidade_minima">
                                    <small>Estoque mínimo atual: <%= produto.quantidade_minima %>  </small>
                                </div>
                            </div>
                        <% } %>  
                        <div class="grupo-formulario">
                            <label class="label-formulario">Novo Valor da Compra</label>
                            <input type="number" class="controle-formulario" name="novo_valor_compra" >
                            <small>Último valor registrado: R$ <%= produto.valor_compra %> </small>
                        </div>
                        <button type="submit" class="btn-login">
                            Salvar Alterações
                        </button>                   
                        <!-- Botão Voltar -->
                    <div class="text-end mt-3">
                        <a href="/estoque" class="btn btn-login-voltar">
                            <i class="fa-solid fa-arrow-left"></i> Voltar
                        </a>
                    </div>
                    </form>                   
                </div>
            </div>
            </div>         
</section>                                                                       
    <!-- Rodapé -->
    <footer class="rodape">
        <div class="container">
            <p>2026 Desenvolvido por Ritielen Rodrigues.</p>
        </div>
    </footer>
    <script src="/js/estoqueScript.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>