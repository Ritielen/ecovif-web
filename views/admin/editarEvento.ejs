<!DOCTYPE html>
<html lang="pt">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cadastro-Evento</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style-raiz.css">
  <link rel="stylesheet" href="/css/style-login.css">
  <link rel="stylesheet" href="/css/style-area-gestor.css">
  <link rel="stylesheet" href="/css/style-cardapio.css">
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="/area-gestor"><i class="fa-solid fa-utensils"></i> ECOVIF
        <span class="tagline">Sistema de Gestão para Restaurantes</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/area-gestor">
              <i class="fa-solid fa-user-shield"></i>Área do Gestor</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/eventos">Voltar</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/suporte">Suporte</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login" id="logoutBtn">
              <i class="fa-solid fa-sign-out-alt"></i>
              Sair</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Header da Área do Gestor -->
  <section class="cabecalho-gestor">
    <div class="container">
      <div class="welcome-box">
        <div class="user-info">
          <div class="user-avatar">
            <i class="fa-solid fa-user-circle"></i>
          </div>
          <div>
            <h1>Edite o seu Evento</h1>
            <p>Organize eventos e automatize a cobrança de couvert.</p>
          </div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- Principal -->
  <main class="funcionalidades-grid">
    <div class="container">
      <div class="row">

        <!-- Seção Formulário -->
        <section class="col-lg-5 secao-formulario">
          <div class="caixa-formulario">
            <h2>Editar Evento</h2>

            <% if(eventos && eventos.length > 0) { %>
            <% const evento = eventos[0]; // Pega o primeiro evento %>
            <form action="/editarEvento/<%= evento.id %>" method="POST">

              <!-- Campo Descrição -->
              <div class="grupo-formulario">

                <label class="label-formulario">Descrição</label>
                <input type="text" class="controle-formulario" id="descricao" name="descricao" placeholder="Ex: Show de MPB" value="<%= evento.descricao %>">
              </div>

              <!-- Campo Data -->
              <div class="grupo-formulario">
                <label class="label-formulario">Data do Evento</label>
                <input type="date" class="controle-formulario" id="dataEvento" name="data">
                <small>Data atual: <%= evento.data %></small>
              </div>

              <!-- Campo Horário -->
              <div class="grupo-formulario">
                <label class="label-formulario">Horário</label>
                <input type="time" class="controle-formulario" id="horaEvento" name="horario">
                <small>Horário atual: <%= evento.horario %></small>
              </div>

              <div class="grupo-formulario">
                <label class="label-formulario">Valor do Couvert (R$)</label>
                <input type="number" class="controle-formulario" id="valorCouvert" name="valor_couvert" placeholder="0,00" step="0.01">
                <small class="texto-ajuda">Valor atual: R$ <%= evento.valor_couvert %></small>
              </div>

              <button type="submit" class="btn-login">
                <i class="fa-solid fa-plus-circle"></i> <span id="textoBotao">Salvar Alterações</span>
              </button>

            </form>
            <% } else { %>
            <p>Nenhum evento encontrado para editar.</p>
            <% } %>
          </div>
        </section>

        <!-- Botão Voltar -->
        <div class="text-end mt-3">
          <a href="/eventos" class="btn btn-login-voltar"><i class="fa-solid fa-arrow-left"></i>
            Voltar</a>
        </div>
      </div>
    </div>
  </main>

  <!-- Rodapé -->
  <footer class="rodape">
    <div class="container">
      <p>2026 Desenvolvido por Ritielen Rodrigues.</p>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>