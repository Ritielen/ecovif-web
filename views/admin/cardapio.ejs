<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Cardápio - ECOVIF</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style-raiz.css">
    <link rel="stylesheet" href="/css/style-login.css">
    <link rel="stylesheet" href="/css/style-area-gestor.css">
    <link rel="stylesheet" href="/css/style-cardapio.css">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#ecovif">
                <i class="fa-solid fa-utensils"></i> ECOVIF
                <span class="tagline">Sistema de Gestão para Restaurantes</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/areaGestor">
                            <i class="fa-solid fa-user-shield"></i> Área do Gestor
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/suporte">Suporte</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/login" id="logoutBtn">
                            <i class="fa-solid fa-sign-out-alt"></i> Sair
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- Header da Área do Gestor -->
    <section class="cabecalho-gestor">
        <div class="container">
            <div class="welcome-box">
                <div class="user-info">
                    <div class="user-avatar">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </div>
                    <div>
                        <h1>Cadastrar Cardápio</h1>
                        <p>Gerencie os itens do cardápio do restaurante</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Principal -->
    <main class="funcionalidades-grid">
        <div class="container">
            <div class="row">
                <!-- Seção Formulário -->
                <section class="col-lg-5 secao-formulario">
                    <div class="caixa-formulario">
                        <h2>Adicionar Item</h2>
                        <!-- Formulário de Cadastro de Item -->
                        <%- include('../partials/alerts') %>

                            <!-- Seletor de Categoria -->
                            <div class="grupo-formulario">
                                <label for="categoria" class="label-formulario">Categoria</label>
                                <select class="controle-formulario" id="categoria" name="categoria" required>
                                    <option value="" disabled selected>Selecione...</option>
                                    <option value="prato">Prato</option>
                                    <option value="bebida">Bebida</option>
                                </select>
                            </div>
                            <!-- Formulário para Pratos -->
                            <form id="formCadastroPrato" action="/cardapioCadastrarPrato" method="POST"
                                style="display:none;">

                                <div id="formPrato" class="formulario-tipo">
                                    <div class="grupo-formulario">
                                        <label for="nome" class="label-formulario">Nome do Prato (descrição)</label>
                                        <input type="text" name="nome" id="nome" class="controle-formulario"
                                            placeholder="Ex.: Filé Mignon com Batata" required>
                                    </div>
                                    <div class="grupo-formulario">
                                        <label for="ingrediente" class="label-formulario">Ingredientes</label>
                                        <div id="container-ingredientes">
                                            <div class="linha-ingrediente">
                                                <div class="campo-ingrediente">
                                                    <select name="produto_id" id="ingrediente"
                                                        class="controle-formulario" required>
                                                        <option value="" disabled selected>Selecione um produto...
                                                        </option>
                                                        <% if (produtos && produtos.length> 0) { %>
                                                            <% produtos.forEach(function(produto) { %>
                                                                <option value="<%= produto.id %>">
                                                                    <%= produto.nome %>
                                                                        <% if (produto.unidade) { %> (<%=
                                                                                produto.unidade %>) <% } %>
                                                                </option>
                                                                <% }) %>
                                                                    <% } else { %>
                                                                        <option value="" disabled>Nenhum produto
                                                                            cadastrado</option>
                                                                        <% } %>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="campo-quantidade">
                                            <input type="number" name="quantidade_ingrediente"
                                                id="quantidade_ingrediente" class="controle-formulario input-quantidade"
                                                placeholder="Quantidade" style="border-radius:4px 0 0 4px;" required>
                                        </div>
                                        <div class="botoes-ingrediente">
                                            <button type="button" class="btn-adicionar-ingrediente">
                                                <i class="fa-solid fa-plus"></i>
                                            </button>
                                            <button type="button" class="btn-remover-ingrediente"
                                                title="Remover ingrediente">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                    </div>
                    <div class="linha-formulario">
                        <div class="grupo-formulario">
                            <label for="rendimento" class="label-formulario">Rendimento</label>
                            <input type="text" name="rendimento" id="rendimento" class="controle-formulario"
                                placeholder="Ex.: 2 porções" required>
                        </div>
                    </div>
                    <div class="grupo-formulario">
                        <label for="custo_prato" class="label-formulario">Custo do Prato (R$)</label>
                        <input type="number" name="custo_prato" id="custo_prato" class="controle-formulario"
                            placeholder="0.00" step="0.01" min="0" required>
                    </div>
                    <div class="grupo-formulario">
                        <label for="preco_venda" class="label-formulario">Preço de venda (R$)</label>
                        <input type="number" name="preco_venda" id="preco_venda" class="controle-formulario"
                            placeholder="0.00" step="0.01" min="0" required>
                    </div>
            </div>
            <!-- Botão adicionar item -->
            <button type="submit" class="btn-login">
                <i class="fa-solid fa-plus-circle"></i> Adicionar Item
            </button>
            </form>
        </div>
        <!-- Formulário para Bebidas -->
        <form id="formCadastroBebida" action="/cardapioCadastrarBebida" method="POST" style="display:none;">
            <div id="formBebida" class="formulario-tipo">
                <div class="grupo-formulario">
                    <label for="produto_id" class="label-formulario">Selecionar Produto (Bebida)</label>
                    <select name="produto_id" id="produto_id" class="controle-formulario" required>
                        <option value="" disabled selected>Selecione a bebida...</option>
                        <% if (produtos && produtos.length> 0) { %>
                            <% produtos.forEach(function(produto) { %>
                                <option value="<%= produto.id %>">
                                    <%= produto.nome %>
                                        — <%= produto.tamanho %>
                                            <%= produto.unidade %>
                                                <% if (produto.tipo_vinho) { %>
                                                    (<%= produto.tipo_vinho.charAt(0).toUpperCase() +
                                                        produto.tipo_vinho.slice(1) %>)
                                                        <% } %>
                                </option>
                                <% }) %>
                                    <% } else { %>
                                        <option value="" disabled>Nenhum produto cadastrado</option>
                                        <% } %>
                    </select>
                    <small class="ajuda-formulario">Os dados de tamanho, unidade e tipo são puxados automaticamente do
                        produto.</small>
                </div>
            </div>
            <div class="grupo-formulario">
                <label for="preco_venda" class="label-formulario">Preço de venda (R$)</label>
                <input type="number" name="preco_venda" id="preco_venda" class="controle-formulario" placeholder="0.00"
                    step="0.01" min="0" required>
            </div>
            <!-- Botão adicionar item -->
            <button type="submit" class="btn-login">
                <i class="fa-solid fa-plus-circle"></i> Adicionar Item
            </button>
        </form>
        </section>
        <!-- Seção Lista -->
        <section class="col-lg-7 secao-lista">
            <!-- ========== BARRA DE PESQUISA ========== -->
            <div class="barra-pesquisa-wrapper">
                <label for="inputPesquisa">
                    <i class="fa-solid fa-magnifying-glass"></i> Pesquisar item do cardápio
                </label>
                <div class="linha-pesquisa">
                    <input type="text" id="inputPesquisa" class="input-pesquisa"
                        placeholder="Ex.: Suco de Uva, Merlot, Filé Mignon..." autocomplete="off">
                    <button type="button" class="btn-pesquisar" id="btnPesquisar">
                        <i class="fa-solid fa-search"></i> Pesquisar
                    </button>
                    <div class="filtro-wrapper">
                        <button type="button" class="btn-filtro" id="btnFiltro">
                            <i class="fa-solid fa-filter"></i> Filtrar
                        </button>
                        <div class="filtro-dropdown" id="filtroDropdown">
                            <button type="button" class="filtro-opcao ativo" data-filtro="todos">
                                <i class="fa-solid fa-border-all"></i> Todos
                            </button>
                            <button type="button" class="filtro-opcao" data-filtro="prato">
                                <i class="fa-solid fa-drumstick-bite"></i> Pratos
                            </button>
                            <button type="button" class="filtro-opcao" data-filtro="bebida">
                                <i class="fa-solid fa-glass-cheers"></i> Bebidas
                            </button>
                        </div>
                    </div>
                </div>
                <div class="filtro-ativo-tag" id="filtroAtivoTag">
                    <i class="fa-solid fa-tag"></i> Filtro ativo: <span id="filtroAtivoNome">Todos</span>
                    <button type="button" class="btn-limpar-filtro" id="btnLimparFiltro">Limpar</button>
                </div>
            </div>
            <div class="msg-sem-resultado" id="msgSemResultado">
                <i class="fa-solid fa-magnifying-glass"></i> Nenhum item encontrado para "<span
                    id="termoPesquisado"></span>
            </div>
            <!-- ================= PRATOS ================= -->
            <div class="caixa-categoria">
                <h3><i class="fa-solid fa-drumstick-bite"></i> Pratos</h3>
                <div class="lista-itens">
                    <% if (pratos && pratos.length> 0) { %>
                        <% pratos.forEach(function(prato) { %>
                            <div class="conteudo-item">
                                <h4>
                                    <%= prato.nome %>
                                </h4>
                                <div class="ingredientes-lista">
                                    <strong>Ingredientes:</strong>
                                    <ul>
                                        <li>
                                            <% if (produtos && produtos.length> 0) { %>
                                                <% produtos.forEach(function(produto) { %>
                                                    <%= produto.nome %>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <p class="texto-vazio">Nenhum ingrediente cadastrado.
                                                                </p>
                                                                <% } %>
                                        <li>
                                            <% if (ingredientes && ingredientes.length> 0) { %>
                                                <% ingredientes.forEach(function(ingrediente) { %>
                                                    <%= ingrediente.quantidade_ingrediente %>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <p class="texto-vazio">Nenhuma quantidade cadastrada.
                                                                </p>
                                                                <% } %>
                                        </li>
                                    </ul>
                                </div>
                                <div class="info-item">
                                    <div><strong>Rendimento:</strong>
                                        <%= prato.rendimento %>
                                    </div>
                                    <div><strong>Custo:</strong> R$ <%= prato.custo_prato.toFixed(2) %>
                                    </div>
                                </div>
                                <div class="preco-lucro">
                                    <span class="preco-destaque">Preco: R$ <%= prato.preco_venda.toFixed(2) %></span>
                                    <span class="lucro-destaque"> Lucro: <%= prato.lucro %>%</span>
                                </div>
                                <div class="acoes-item">
                                    <!-- EDITAR -->
                                    <form action="/cardapioPratoEditar/<%= prato.id %>" method="POST"
                                        style="flex: 1; display: contents;">
                                        <button type="button" class="btn-editar"
                                            onclick="editarItem('<%= prato.id %>', 'prato')">
                                            <i class="fa-solid fa-edit"></i> Editar
                                        </button>
                                    </form>
                                    <!-- EXCLUIR -->
                                    <form action="/cardapioPratoExcluir/<%= prato.id %>" method="POST"
                                        style="flex: 1; display: contents;">
                                        <button type="submit" class="btn-excluir"
                                            onclick="return confirm('Deseja excluir este prato?');">
                                            <i class="fa-solid fa-trash"></i> Excluir
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p class="texto-vazio">Nenhum prato cadastrado.</p>
                                    <% } %>
                </div>
            </div>
            <!-- ================= BEBIDAS ================= -->
            <div class="caixa-categoria">
                <h3><i class="fa-solid fa-glass-cheers"></i> Bebidas</h3>
                <div class="lista-itens">
                    <% if (produtos && produtos.length> 0) { %>
                        <% produtos.forEach(function(produto) { %>
                            <div class="conteudo-item">
                                <h4>🥤 <%= produto.nome %>
                                </h4>
                                <div class="info-item">
                                    <div><strong>Tamanho:</strong>
                                        <%= produto.tamanho %>
                                            <%= produto.unidade %>
                                    </div>
                                </div>
                                <div class="preco-lucro">
                                    <% if (bebidas && bebidas.length> 0) { %>
                                        <% bebidas.forEach(function(bebida) { %>
                                            <span class="preco-destaque">R$ <%= bebida.preco_venda.toFixed(2) %></span>
                                            <% }) %>
                                                <% } else { %>
                                                    <p class="texto-vazio">Nenhum preço cadastrado.</p>
                                                    <% } %>
                                </div>
                                <div class="acoes-item">
                                    <form action="/cardapioBebidaEditar/<%= bebida.id %>" method="POST"
                                        style="flex: 1; display: contents;">
                                        <button type="button" class="btn-editar"
                                            onclick="editarItem('<%= bebida.id %>', 'bebida')">
                                            <i class="fa-solid fa-edit"></i> Editar
                                        </button>
                                    </form>
                                    <form action="/cardapioBebidaExcluir/<%= bebida.id %>" method="POST"
                                        style="flex: 1; display: contents;">
                                        <button type="submit" class="btn-excluir"
                                            onclick="return confirm('Deseja excluir esta bebida?');">
                                            <i class="fa-solid fa-trash"></i> Excluir
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p class="texto-vazio">Nenhuma bebida cadastrada.</p>
                                    <% } %>
                </div>
            </div>
            <div class="text-end mt-3">
                <a href="/admin/areaGestor" class="btn btn-login-voltar">
                    <i class="fa-solid fa-arrow-left"></i> Voltar
                </a>
            </div>
        </section>
        </div>
        </div>
    </main>
    <!-- Rodapé -->
    <footer class="rodape">
        <div class="container">
            <p>2026 Desenvolvido por Ritielen Rodrigues</p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cardapioScript.js"></script>
</body>

</html>