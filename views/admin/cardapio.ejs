<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cadastro de Cardápio - ECOVIF</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style-raiz.css">
  <link rel="stylesheet" href="/css/style-login.css">
  <link rel="stylesheet" href="/css/style-area-gestor.css">
  <link rel="stylesheet" href="/css/style-cardapio.css">
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="/area-gestor">
        <i class="fa-solid fa-utensils"></i> ECOVIF
        <span class="tagline">Sistema de Gestão para Restaurantes</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/area-gestor">
              <i class="fa-solid fa-user-shield"></i> Área do Gestor
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/eventos">
              <i class="fas fa-calendar"></i> Eventos
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/comanda">
              <i class="fa-solid fa-receipt"></i> Comandas
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/suporte">Suporte</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/estoque">Voltar</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login" id="logoutBtn">
              <i class="fa-solid fa-sign-out-alt"></i> Sair
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <!-- Header da Área do Gestor -->
  <section class="cabecalho-gestor">
    <div class="container">
      <div class="welcome-box">
        <div class="user-info">
          <div class="user-avatar">
            <i class="fa-solid fa-clipboard-list"></i>
          </div>
          <div>
            <h1>Cadastrar Cardápio</h1>
            <p>Gerencie os pratos e bebidas do cardápio do restaurante</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Principal -->
  <main class="funcionalidades-grid">
    <div class="container">
      <div class="row">
        <!-- Seção Formulário -->
        <section class="col-lg-5 secao-formulario">
          <div class="caixa-formulario">
            <h2>Cadastrar pratos e bebidas</h2>

            <%- include('../partials/alerts') %>

            <div class="card-formulario">
              <form id="formCadastroPrato" action="/cadastroCardapio" method="POST">

                <!-- 1. Seletor de Categoria (Sempre Visível) -->
                <div class="grupo-formulario">
                  <label for="categoria" class="label-formulario">Categoria</label>
                  <select class="controle-formulario" id="categoria" name="categoria" required>
                    <option value="" disabled selected>Selecione...</option>
                    <option value="prato">Prato</option>
                    <option value="bebida">Bebida</option>
                  </select>
                </div>

                <!-- 2. Container Dinâmico (Começa escondido) -->
                <div id="conteudoFormulario" style="display: none;">

                  <!-- Bloco Prato -->
                  <div id="formPrato" class="formulario-tipo" style="display: none;">
                    <div class="grupo-formulario">
                      <label for="nome" class="label-formulario">Nome do Prato</label>
                      <input type="text" name="nome" id="nome" class="controle-formulario" placeholder="Ex.: Filé Mignon">
                    </div>

                    <!-- Parte de Ingredientes (Tela de Cardápio) -->
                    <div id="container-ingredientes">
                      <label class="label-formulario">Ingrediente e Qtd</label>
                      <div class="linha-ingrediente" style="display: flex; gap: 5px; margin-bottom: 10px;">
                        <select name="produto_id" class="controle-formulario select-busca">
                          <option value="" disabled selected>Selecionar Insumo...</option>

                          <% if (produtos && produtos.length > 0) { %>

                          <!-- Grupo de Produtos que são Ingredientes/Insumos -->
                          <optgroup label="Insumos / Cozinha">
                            <% produtos.forEach(function(p) { %>
                            <% if (p.tipo_item !== 'bebida') { %>
                            <option value="<%= p.id %>">
                              <%= p.nome %> <%= p.quantidade || '' %> <%= p.unidade %>
                            </option>
                            <% } %>
                            <% }) %>
                          </optgroup>

                          <!-- Grupo de Produtos que são Bebidas -->
                          <optgroup label="Bebidas / Bar">
                            <% produtos.forEach(function(p) { %>
                            <% if (p.tipo_item === 'bebida') { %>
                            <option value="<%= p.id %>">
                              <%= p.nome %> <%= p.tamanho || '' %> <%= p.unidade %>
                            </option>
                            <% } %>
                            <% }) %>
                          </optgroup>

                          <% } %>
                        </select>
                        <input type="number" name="quantidade_ingrediente" class="controle-formulario" style="width: 80px;" placeholder="0">
                        <div class="grupo-formulario">
                          <label class="label-formulario">Unidade</label>
                          <select class="controle-formulario" name="unidade_ingrediente" data-required="true">
                            <option value="" disabled selected>Selecione...</option>
                            <option value="kg">kg</option>
                            <option value="g">g</option>
                            <option value="l">Litros(l)</option>
                            <option value="ml">Mililitros(ml)</option>
                            <option value="un">un</option>
                          </select>
                        </div>
                        <button type="button" class="btn-adicionar-ingrediente"><i class="fa-solid fa-plus"></i></button>
                        <button type="button" class="btn-remover-ingrediente"><i class="fa-solid fa-trash"></i></button>
                      </div>
                    </div>
                    <div class="grupo-formulario">
                      <label for="rendimento" class="label-formulario">Rendimento</label>
                      <input type="text" name="rendimento" id="rendimento" class="controle-formulario" placeholder="rendimento por porção">
                    </div>

                    <div class="grupo-formulario">
                      <label for="custo_prato" class="label-formulario">Custo do Prato (R$)</label>
                      <input type="number" name="custo_prato" id="custo_prato" class="controle-formulario" placeholder="0.00" step="0.01">
                    </div>
                  </div>

                  <!-- Bloco Bebida -->
                  <div id="formBebida" class="formulario-tipo" style="display: none;">

                    <div class="grupo-formulario">

                      <label for="bebida_produto_id" class="label-formulario">
                        Selecionar Bebida
                      </label>

                      <select name="produto_id" id="bebida_produto_id" class="controle-formulario">

                        <option value="" disabled selected>
                          Selecione...
                        </option>

                        <% produtos.forEach(function(p) { %>

                        <% if (p.tipo_item === 'bebida') { %>

                        <option value="<%= p.id %>">
                          <%= p.nome %>
                          <%= p.tamanho || '' %>
                          <%= p.unidade %>
                        </option>

                        <% } %>

                        <% }) %>

                      </select>

                    </div>

                  </div>

                  <!-- Campos Finais -->
                  <div class="grupo-formulario">
                    <label for="preco_venda" class="label-formulario">Preço de Venda (R$)</label>
                    <input type="number" name="preco_venda" id="preco_venda" class="controle-formulario" step="0.01" required>
                  </div>
                  <button type="submit" class="btn-login">
                    <i class="fa-solid fa-plus-circle"></i> Adicionar Item
                  </button>
                </div> <!-- Fim conteudoFormulario -->
              </form>
            </div> <!-- Fim card-formulario -->
          </div> <!-- Fim caixa-formulario -->
        </section> <!-- Fim secao-formulario -->

        <!-- Seção Lista -->
        <section class="col-lg-7 secao-lista">
          <!-- ========== BARRA DE PESQUISA ========== -->
          <div class="barra-pesquisa-wrapper">
            <label for="inputPesquisa"><i class="fa-solid fa-magnifying-glass"></i> Pesquisar item do cardápio</label>
            <div class="linha-pesquisa">
              <input type="text" id="inputPesquisa" class="input-pesquisa" placeholder="Ex.: Suco de Uva, Merlot, Filé Mignon..." autocomplete="off">
              <button class="btn-pesquisar" id="btnPesquisar">
                <i class="fa-solid fa-search"></i> Pesquisar
              </button>
              <div class="filtro-wrapper">
                <button class="btn-filtro" id="btnFiltro">
                  <i class="fa-solid fa-filter"></i> Filtrar
                </button>
                <div class="filtro-dropdown" id="filtroDropdown">
                  <button class="filtro-opcao ativo" data-filtro="todos">
                    <i class="fa-solid fa-border-all"></i> Todos
                  </button>
                  <button class="filtro-opcao" data-filtro="prato">
                    <i class="fa-solid fa-drumstick-bite"></i> Pratos
                  </button>
                  <button class="filtro-opcao" data-filtro="bebida">
                    <i class="fa-solid fa-glass-cheers"></i> Bebidas
                  </button>

                </div>
              </div>
            </div>
            <div class="filtro-ativo-tag" id="filtroAtivoTag">
              <i class="fa-solid fa-tag"></i> Filtro ativo: <span id="filtroAtivoNome">Todos</span>
              <button class="btn-limpar-filtro" id="btnLimparFiltro">Limpar</button>
            </div>
          </div>

          <div class="msg-sem-resultado" id="msgSemResultado">
            <i class="fa-solid fa-magnifying-glass"></i> Nenhum item encontrado para "<span id="termoPesquisado"></span>".
          </div>

          <!-- ================= PRATOS ================= -->
          <div class="caixa-categoria">

            <h3>
              <i class="fa-solid fa-drumstick-bite"></i>
              Pratos
            </h3>

            <div class="lista-itens">

              <% if (pratos && pratos.length > 0) { %>

              <% pratos.forEach(function(prato) { %>

              <div class="conteudo-item">

                <h4><%= prato.nome %></h4>

                <div class="ingredientes-lista">

                  <strong>Ingredientes:</strong>

                  <ul>

                    <% prato.ingredientes.forEach(function(ingrediente) { %>

                    <li>

                      <% if (ingrediente.produto) { %>

                      <%= ingrediente.produto.nome %> -
                      <%= ingrediente.quantidade_ingrediente %>
                      <%= ingrediente.unidade_ingrediente %>

                      <% } else { %>

                      Produto removido do estoque

                      <% } %>

                    </li>

                    <% }) %>

                  </ul>

                </div>

                <div class="info-item">

                  <div>
                    <strong>
                      Rendimento da porção:
                      <%= prato.rendimento %>
                    </strong>
                  </div>

                  <div>
                    <strong>
                      Custo:
                      <%= prato.custo_prato %>
                    </strong>
                  </div>

                </div>

                <div class="preco-lucro">

                  <span class="preco-destaque">
                    Preço: R$ <%= prato.preco_venda %>
                  </span>

                  <span class="lucro-destaque">
                    Lucro: R$ <%= prato.preco_venda - prato.custo_prato %>
                  </span>

                </div>

                <div class="acoes-item">

                  <!-- EDITAR -->
                  <a href="/editarPrato/<%= prato.id %>" class="btn-editar">
                    <i class="fa-solid fa-edit"></i>
                    Editar
                  </a>

                  <!-- EXCLUIR -->
                  <form action="/excluirPrato/<%= prato.id %>" method="POST">

                    <button type="submit" class="btn-excluir" onclick="return confirm('O prato só pode ser excluído se não estiver em uma comanda.');">
                      <i class="fa-solid fa-trash"></i>
                      Excluir
                    </button>

                  </form>

                </div>

              </div>

              <% }) %>

              <% } else { %>

              <p class="texto-vazio">
                Nenhum prato cadastrado.
              </p>

              <% } %>

            </div>

          </div>
          <!-- =====bebidas========== -->
          <div class="caixa-categoria">
            <h3><i class="fa-solid fa-glass-cheers"></i> Bebidas</h3>

            <div class="lista-itens">

              <% if (bebidas && bebidas.length > 0) { %>
              <% bebidas.forEach(function(bebida) { %>

              <div class="conteudo-item">
                <h4> 🥤 <%= bebida.produto.nome %></h4>

                <div class="info-item">
                  <div>
                    <strong>Tamanho:</strong>
                    <%= bebida.produto.tamanho %>
                    <%= bebida.produto.unidade %>
                  </div>
                </div>

                <div class="preco-lucro">
                  <span class="preco-destaque">
                    R$ <%= bebida.preco_venda %>
                  </span>
                </div>

                <div class="acoes-item">
                  <a href="/editarBebida/<%= bebida.id %>" class="btn-editar">
                    <i class="fa-solid fa-edit"></i> Editar
                  </a>

                  <form action="/excluirBebida/<%= bebida.id %>" method="POST">
                    <button type="submit" class="btn-excluir" onclick="return confirm('A bebida só pode ser excluída se não estiver em uma comanda.');">
                      <i class="fa-solid fa-trash"></i> Excluir
                    </button>
                  </form>
                </div>
              </div>
              <% }) %>
              <% } else { %>
              <p class="texto-vazio">
                Nenhuma bebida cadastrada.
              </p>
              <% } %>
            </div>
          </div>
          <div class="text-end mt-3">
            <a href="/area-gestor" class="btn btn-login-voltar">
              <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>
  <!-- Rodapé -->
  <footer class="rodape">
    <div class="container">
      <p>2026 Desenvolvido por Ritielen Rodrigues</p>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script src="/js/formularioCardapioScript.js"></script>

  <script src="/js/filtroCardapioScript.js"></script>

</body>

</html>