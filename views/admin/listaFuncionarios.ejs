<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de Funcionários - ECOVIF</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style-raiz.css">
  <link rel="stylesheet" href="/css/style-login.css">
  <link rel="stylesheet" href="/css/style-area-gestor.css">
  <link rel="stylesheet" href="/css/style-funcionario.css">
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="#ecovif"><i class="fa-solid fa-utensils"></i> ECOVIF
        <span class="tagline">Sistema de Gestão para Restaurantes</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/area-gestor">
              <i class="fa-solid fa-user-shield"></i> Área do Gestor
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/suporte">
              <i class="fa-solid fa-headset"></i> Suporte
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login" id="logoutBtn">
              <i class="fa-solid fa-sign-out-alt"></i>
              Sair</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <section class="cabecalho-gestor">
    <div class="container">
      <div class="welcome-box">
        <div class="user-info">
          <div class="user-avatar"><i class="fa-solid fa-users"></i></div>
          <div>
            <h1>Funcionários Cadastrados</h1>
            <p>Gerencie os acessos e informações da equipe</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="container mt-4">
    <div class="row">
      <section class="col-12 secao-lista">
        <div class="caixa-categoria">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3><i class="fa-solid fa-list"></i> Lista de Funcionários</h3>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <a href="/cadastrarFuncionario" class="btn btn-success btn-sm">
              <i class="fa-solid fa-plus"></i> Novo Funcionário
            </a>
          </div>


          <div class="table-responsive">
            <table class="table table-striped">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Nome</th>
                  <th>Sobrenome</th>
                  <th>Grupo</th>
                  <th>Telefone</th>
                  <th>Email</th>
                  <th>Tipo Funcionario</th>
                  <th>Criado Pelo Usuário</th>
                  <th>Admin</th>
                  <th>Ações</th>
                </tr>
              </thead>
              <tbody id="listaFuncionarios">
                <% if (funcionarios && funcionarios.length> 0) { %>
                <% funcionarios.forEach(funcionario=> { %>
                <tr>
                  <td>
                    <%= funcionario.id %>
                  </td>
                  <td>
                    <%= funcionario.nome %>
                  </td>
                  <td>
                    <%= funcionario.sobrenome %>
                  </td>
                  <td>
                    <% if (funcionario.grupo) { %>
                    <span class="badge bg-primary">
                      <%= funcionario.grupo.nome_grupo %>
                    </span>
                    <% } else { %>
                    <span class="badge bg-secondary">Sem grupo</span>
                    <% } %>
                  </td>
                  <td>
                    <%= funcionario.telefone %>
                  </td>
                  <td>
                    <%= funcionario.email %>
                  </td>
                  <td>
                    <%= funcionario.funcionario %>
                  </td>
                  <td><%= funcionario.criado_por %></td>
                  <td>
                    <%= funcionario.admin ? "Sim" : "Não" %>
                  </td>
                  <td>
                    <a href="/admin/funcionario/editar/<%= funcionario.id %>" class="btn-editar" role="button">
                      <i class="fa-solid fa-edit"></i> Editar
                    </a>
                    <form action="/admin/funcionarios/excluir/<%= funcionario.id %>" method="POST" style="display:inline;">
                      <button type="submit" class="btn-excluir" onclick="return confirm('Deseja excluir este funcionário?');">
                        <i class="fa-solid fa-trash"></i> Excluir
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
                <% } else { %>
                <tr>
                  <td colspan="9" style="text-align: center; padding: 40px;">
                    <p class="texto-vazio">Nenhum funcionário cadastrado.</p>
                    <a href="/cadastrarFuncionario" class="btn btn-primary btn-sm">
                      <i class="fa-solid fa-plus"></i> Cadastrar Primeiro
                      Funcionário
                    </a>
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
      <!-- Botão Voltar -->
      <div class="text-end mt-3">
        <a href="/cadastrarFuncionario" class="btn btn-login-voltar"><i class="fa-solid fa-arrow-left"></i>
          Voltar</a>
      </div>
    </div>
  </main>

  <footer class="rodape mt-5">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <div class="container text-center">
      <p>2026 Desenvolvido por Ritielen Rodrigues.</p>
    </div>
  </footer>
</body>

</html>